<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <ScenPartDef>
    <defName>Site44_Facility</defName>
    <label>facility start</label>
    <category>Fixed</category>
    <scenPartClass>Site44.ScenPart_Site44Facility</scenPartClass>
    <summaryPriority>390</summaryPriority>
    <canBeRandomlyAdded>false</canBeRandomlyAdded>
    <canBePlayerAddedRemoved>false</canBePlayerAddedRemoved>
  </ScenPartDef>

  <ScenarioDef ParentName="ScenarioBase">
    <defName>Site44_Breach</defName>
    <label>Site-44 Breach</label>
    <description>The facility perimeter gave out years ago. Beyond the courtyard the bulkheads are still sealed, and something inside is still running. It has already decided what you are.

Playing with Ideology? Choose the Classic ideoligion on the ideoligion page: a party inside the ruins cannot meet altar, ritual or building demands.</description>
    <scenario Class="Site44.Site44Scenario">
      <summary>Start in the breached courtyard of a sealed megastructure.</summary>
      <parts>

        <li Class="Site44.ScenPart_Site44StartingPawns">
          <def>ConfigPage_ConfigureStartingPawns</def>
          <pawnCount>3</pawnCount>
          <pawnChoiceCount>8</pawnChoiceCount>
          <requiredSkills>
            <li>Shooting</li>
            <li>Intellectual</li>
          </requiredSkills>
        </li>

        <li Class="ScenPart_PlayerPawnsArriveMethod">
          <def>PlayerPawnsArriveMethod</def>
          <method>Standing</method>
          <visible>false</visible>
        </li>

        <li Class="Site44.ScenPart_Site44Facility">
          <def>Site44_Facility</def>
        </li>


      </parts>
    </scenario>
  </ScenarioDef>

</Defs>

