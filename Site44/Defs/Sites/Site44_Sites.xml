<?xml version="1.0" encoding="utf-8"?>
<!-- Generated from the site type table: one site part, generation step and quest per ruined-complex type. -->
<Defs>

  <SitePartDef>
    <defName>Site44_Ruin_Medical</defName>
    <label>ruined medical center</label>
    <description>The ruins of a hospital complex: wards, operating theaters, a pharmacy and a morgue, picked over but never emptied.</description>
    <siteTexture>World/WorldObjects/Sites/GenericSite</siteTexture>
    <expandingIconTexture>World/WorldObjects/Expanding/Sites/ItemStash</expandingIconTexture>
    <minMapSize>(200, 1, 200)</minMapSize>
    <tags><li>Site44RuinMedical</li></tags>
  </SitePartDef>

  <GenStepDef>
    <defName>Site44_RuinSite_Medical</defName>
    <linkWithSite>Site44_Ruin_Medical</linkWithSite>
    <order>800</order>
    <genStep Class="Site44.GenStep_Facility" />
  </GenStepDef>

  <QuestScriptDef>
    <defName>OpportunitySite_Site44_Medical</defName>
    <rootSelectionWeight>0.4</rootSelectionWeight>
    <rootMinPoints>0</rootMinPoints>
    <autoAccept>true</autoAccept>
    <questNameRules>
      <rulesStrings>
        <li>questName->[place] of [people]</li>
        <li>place->Clinic</li>
        <li>place->Ward</li>
        <li>place->Hospital</li>
        <li>place->Infirmary</li>
        <li>people->the Sleepless</li>
        <li>people->Quiet Hands</li>
        <li>people->the Last Shift</li>
        <li>people->Gauze and Lamplight</li>
      </rulesStrings>
    </questNameRules>
    <questDescriptionRules>
      <rulesStrings>
        <li>questDescription->Scouts report the ruins of a large medical center not far from [map_definite]. Wards, operating rooms and a pharmacy may still hold medicine, though not everyone inside is resting peacefully.</li>
      </rulesStrings>
    </questDescriptionRules>
    <root Class="QuestNode_Sequence">
      <nodes>
        <li Class="QuestNode_GetMap" />
        <li Class="QuestNode_Root_Site">
          <sitePartDef>Site44_Ruin_Medical</sitePartDef>
          <worldObjectDef>Site</worldObjectDef>
          <factionDef>Ancients</factionDef>
          <distanceFromColonyRange>5~16</distanceFromColonyRange>
          <selectLandmarkChance>0</selectLandmarkChance>
        </li>
        <li Class="QuestNode_WorldObjectTimeout">
          <worldObject>$site</worldObject>
          <isQuestTimeout>true</isQuestTimeout>
          <delayTicks>$(randInt(20,40)*60000)</delayTicks>
          <inSignalDisable>site.MapGenerated</inSignalDisable>
          <destroyOnCleanup>true</destroyOnCleanup>
          <node Class="QuestNode_Sequence">
            <nodes>
              <li Class="QuestNode_Letter">
                <label TKey="LetterLabelQuestExpired">Quest expired: [resolvedQuestName]</label>
                <text TKey="LetterTextQuestExpired">The ruins have been scavenged by others, or buried again by the wasteland. The quest [resolvedQuestName] has expired.</text>
              </li>
              <li Class="QuestNode_End"><outcome>Fail</outcome></li>
            </nodes>
          </node>
        </li>
        <li Class="QuestNode_NoWorldObject">
          <worldObject>$site</worldObject>
          <node Class="QuestNode_End" />
        </li>
      </nodes>
    </root>
  </QuestScriptDef>

