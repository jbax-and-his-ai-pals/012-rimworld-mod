<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- Vanilla ancient cryosleep casket with Site-44 behaviour: survivors join the party when it opens. -->
  <ThingDef ParentName="AncientCryptosleepCasket">
    <defName>Site44_Casket</defName>
    <label>sealed cryosleep casket</label>
    <description>A cryosleep casket sealed since before the facility fell silent. The status light is dead, so there is no telling what is inside.</description>
    <thingClass>Site44.Building_Site44Casket</thingClass>
    <building>
      <deconstructible>false</deconstructible>
      <claimable>false</claimable>
    </building>
  </ThingDef>

  <!-- The welcome cache behind the front desk of the principal building: a green-lit hermetic crate. -->
  <ThingDef ParentName="CrateBase">
    <defName>Site44_SupplyCrate</defName>
    <label>welcome supply crate</label>
    <description>A hermetically sealed supply crate with a green light still glowing on its lid. It holds basic supplies.</description>
    <size>(1, 2)</size>
    <fillPercent>0.40</fillPercent>
    <graphicData>
      <texPath>Things/Building/Ruins/AncientHermeticCrate</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <color>(0.55, 0.9, 0.6)</color>
      <drawSize>(1, 2)</drawSize>
      <shadowData>
        <volume>(1, 0.45, 2)</volume>
      </shadowData>
    </graphicData>
    <statBases>
      <MaxHitPoints>250</MaxHitPoints>
      <WorkToBuild>1000</WorkToBuild>
    </statBases>
    <building>
      <openingEffect>HermeticCrateOpened</openingEffect>
    </building>
    <comps>
      <li Class="CompProperties_EmptyStateGraphic">
        <graphicData>
          <texPath>Things/Building/Ruins/AncientHermeticCrateOpen</texPath>
          <graphicClass>Graphic_Multi</graphicClass>
          <color>(0.55, 0.9, 0.6)</color>
          <drawSize>(1, 2)</drawSize>
        </graphicData>
      </li>
      <li Class="CompProperties_ThrownFleckEmitter">
        <fleck>TerminalScreenLensFlare</fleck>
        <offsetMin>(-0.3,0,-0.7)</offsetMin>
        <offsetMax>(0.3,0,-0.7)</offsetMax>
        <emissionInterval>90</emissionInterval>
        <scale>1~1.1</scale>
        <colorA>(90,230,120,255)</colorA>
        <colorB>(90,230,120,255)</colorB>
      </li>
      <li Class="CompProperties_Glower">
        <glowRadius>4</glowRadius>
        <glowColor>(90,230,120,0)</glowColor>
      </li>
    </comps>
    <tickerType>Normal</tickerType>
  </ThingDef>

</Defs>
