      <li><thingDef>ComponentSpacer</thingDef><weight>2</weight></li>
      <li><thingDef>Uranium</thingDef><weight>3</weight></li>
      <li><thingDef>Gold</thingDef><weight>1</weight></li>
    </richLoot>
    <specialties>
      <li><name>Workshop</name><weight>3</weight></li>
      <li><name>LockerRoom</name><weight>3</weight></li>
      <li><name>Kitchen</name><weight>1</weight></li>
