      <li><thingDef>Silver</thingDef><weight>3</weight></li>
      <li><thingDef>ComponentIndustrial</thingDef><weight>2</weight></li>
      <li><thingDef>Plasteel</thingDef><weight>1</weight></li>
    </richLoot>
    <specialties>
      <li><name>Kitchen</name><weight>3</weight></li>
      <li><name>Library</name><weight>2</weight></li>
      <li><name>Classroom</name><weight>2</weight></li>
      <li><name>Dormitory</name><weight>1</weight></li>
    </specialties>
    <strayCorpseFactor>1.6</strayCorpseFactor>
