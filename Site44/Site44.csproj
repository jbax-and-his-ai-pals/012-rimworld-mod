<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>10</LangVersion>
    <AssemblyName>Site44</AssemblyName>
    <RootNamespace>Site44</RootNamespace>
    <RimWorldDir Condition="'$(RimWorldDir)' == ''">C:\steam\steamapps\common\RimWorld</RimWorldDir>
    <Managed>$(RimWorldDir)\RimWorldWin64_Data\Managed</Managed>
    <OutputPath>Assemblies\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <DebugType>none</DebugType>
    <Nullable>disable</Nullable>
  </PropertyGroup>

  <!-- The enclave work is archived (see ARCHIVE.md). It stays in the repository but is left out of the build unless
       -p:IncludeEnclave=true is passed; its defs live in archive/enclave and must be copied into Defs for that build. -->
  <PropertyGroup Condition="'$(IncludeEnclave)' == 'true'">
    <DefineConstants>$(DefineConstants);ENCLAVE</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="'$(IncludeEnclave)' != 'true'">
    <Compile Remove="Source\Enclave\**;Source\GenSteps\GenStep_Enclave.cs;Source\Gen\TownPlan.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <Reference Include="Assembly-CSharp">
      <HintPath>$(Managed)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>$(Managed)\UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(Managed)\UnityEngine.IMGUIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(Managed)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
