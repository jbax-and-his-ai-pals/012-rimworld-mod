<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- Hidden boost to natural wound healing in a Delve run (setting: natural recovery). Severity 0.5 is "faster", 1 is "much faster". -->
  <HediffDef>
    <defName>Site44_Recovery</defName>
    <label>delver recovery</label>
    <description>Conditioning and a rested body mend wounds faster than usual.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <isBad>false</isBad>
    <scenarioCanAdd>false</scenarioCanAdd>
    <initialSeverity>0.5</initialSeverity>
    <maxSeverity>1</maxSeverity>
    <stages>
      <li>
        <label>faster</label>
        <becomeVisible>false</becomeVisible>
        <statFactors>
          <InjuryHealingFactor>1.5</InjuryHealingFactor>
        </statFactors>
      </li>
      <li>
        <label>much faster</label>
        <minSeverity>0.75</minSeverity>
        <becomeVisible>false</becomeVisible>
        <statFactors>
          <InjuryHealingFactor>2.5</InjuryHealingFactor>
        </statFactors>
      </li>
    </stages>
  </HediffDef>

  <!-- Blood pack: restores lost blood at once. -->
  <ThingDef ParentName="DrugPillBase">
    <defName>Site44_BloodPack</defName>
    <label>blood pack</label>
    <description>A sealed pack of matched plasma and clotting agent with a self-priming needle. It restores lost blood at once. It does not close wounds, so a bleeding colonist still needs tending first.</description>
    <graphicData>
      <texPath>Things/Item/Drug/Penoxycyline</texPath>
      <graphicClass>Graphic_StackCount</graphicClass>
      <color>(0.85,0.2,0.25)</color>
    </graphicData>
    <rotatable>false</rotatable>
    <statBases>
      <MarketValue>60</MarketValue>
      <Mass>0.1</Mass>
    </statBases>
    <techLevel>Industrial</techLevel>
    <ingestible>
      <drugCategory>None</drugCategory>
      <outcomeDoers>
        <li Class="Site44.IngestionOutcomeDoer_BloodPack" />
      </outcomeDoers>
    </ingestible>
  </ThingDef>

  <!-- Panacea pill: top-tier find. -->
  <ThingDef ParentName="DrugPillBase">
    <defName>Site44_PanaceaPill</defName>
    <label>panacea pill</label>
    <description>A pearl-white capsule of unmarked make. It closes every wound that can still heal, clears infections, restores lost blood and cures illnesses and poisoning. Scars, missing parts, bionic parts and chronic conditions stay. Only a handful were ever made.</description>
    <graphicData>
      <texPath>Things/Item/Drug/Yayo</texPath>
      <graphicClass>Graphic_StackCount</graphicClass>
      <color>(1,1,0.9)</color>
    </graphicData>
    <rotatable>false</rotatable>
    <statBases>
      <MarketValue>400</MarketValue>
      <Mass>0.02</Mass>
    </statBases>
    <techLevel>Spacer</techLevel>
    <ingestible>
      <drugCategory>None</drugCategory>
      <outcomeDoers>
        <li Class="Site44.IngestionOutcomeDoer_Panacea" />
      </outcomeDoers>
    </ingestible>
  </ThingDef>

  <!-- Renewal capsule: the rarest cure. Restores everything but bionics. Only the deepest guardians keep one. -->
  <ThingDef ParentName="DrugPillBase">
    <defName>Site44_RenewalCapsule</defName>
    <label>renewal capsule</label>
    <description>A gold-banded capsule, warm to the touch. It does everything a panacea pill does and then rebuilds what no pill can: missing parts, old scars and lasting conditions. Bionic parts are kept. It cannot bring back the dead. There are very few of these left.</description>
    <graphicData>
      <texPath>Things/Item/Drug/Yayo</texPath>
      <graphicClass>Graphic_StackCount</graphicClass>
      <color>(1,0.85,0.35)</color>
    </graphicData>
    <rotatable>false</rotatable>
    <statBases>
      <MarketValue>1500</MarketValue>
      <Mass>0.02</Mass>
    </statBases>
    <techLevel>Spacer</techLevel>
    <ingestible>
      <drugCategory>None</drugCategory>
      <outcomeDoers>
        <li Class="Site44.IngestionOutcomeDoer_Renewal" />
      </outcomeDoers>
    </ingestible>
  </ThingDef>

  <!-- Regrowth nanites: rebuild a missing part. Rarer than the panacea. -->
  <ThingDef ParentName="DrugPillBase">
    <defName>Site44_RegrowthNanites</defName>
    <label>regrowth nanites</label>
    <description>A cold ampoule of grey suspension. Swallowed or injected, the nanites rebuild the most important part the colonist has lost. With nothing missing they close an old scar. Rarely found, and not made any more.</description>
    <graphicData>
      <texPath>Things/Item/Drug/Penoxycyline</texPath>
      <graphicClass>Graphic_StackCount</graphicClass>
      <color>(0.75,0.75,0.8)</color>
    </graphicData>
    <rotatable>false</rotatable>
    <statBases>
      <MarketValue>550</MarketValue>
      <Mass>0.02</Mass>
    </statBases>
    <techLevel>Spacer</techLevel>
    <ingestible>
      <drugCategory>None</drugCategory>
      <outcomeDoers>
        <li Class="Site44.IngestionOutcomeDoer_Regrowth" />
      </outcomeDoers>
    </ingestible>
  </ThingDef>

  <!-- Upgrade nanites: swap a natural part for a bionic one. Only found deeper. -->
  <ThingDef ParentName="DrugPillBase">
    <defName>Site44_UpgradeNanites</defName>
    <label>upgrade nanites</label>
    <description>A sealed ampoule of bright silver suspension. The nanites strip one natural part down and rebuild it as a bionic one: arm, leg, eye, heart, spine, stomach or ear, in that order, whichever is still natural. No surgery is needed. They do nothing for a colonist who is already fully upgraded.</description>
    <graphicData>
      <texPath>Things/Item/Drug/Penoxycyline</texPath>
      <graphicClass>Graphic_StackCount</graphicClass>
      <color>(0.55,0.85,1)</color>
    </graphicData>
    <rotatable>false</rotatable>
    <statBases>
      <MarketValue>900</MarketValue>
      <Mass>0.02</Mass>
    </statBases>
    <techLevel>Spacer</techLevel>
    <ingestible>
      <drugCategory>None</drugCategory>
      <outcomeDoers>
        <li Class="Site44.IngestionOutcomeDoer_BionicUpgrade" />
      </outcomeDoers>
    </ingestible>
  </ThingDef>

</Defs>
