  <!-- Residential block: apartments, shared commons. Personal belongings, food, cloth, silver. -->
  <Site44.SiteTypeDef>
    <defName>Site44_Type_Residential</defName>
    <label>residential block</label>
    <description>A residential block of apartments, shared commons, a mail room and a roof garden.</description>
    <sitePart>Site44_Ruin_Residential</sitePart>
    <questScript>OpportunitySite_Site44_Residential</questScript>
    <principalArchetype>Residential</principalArchetype>
    <style>Campus</style>
    <props>residential</props>
    <accent>(0.9, 0.8, 0.55)</accent>
    <steleStuff>BlocksSandstone</steleStuff>
    <archetypeWeights>
      <li><name>Residential</name><weight>4</weight></li>
      <li><name>Commons</name><weight>2</weight></li>
      <li><name>Warehouse</name><weight>1</weight></li>
      <li><name>Office</name><weight>1</weight></li>
    </archetypeWeights>
    <minBuildings>3</minBuildings>
    <maxBuildings>6</maxBuildings>
    <questWeight>0.4</questWeight>
    <loot>
      <li><thingDef>MealSurvivalPack</thingDef><weight>4</weight></li>
      <li><thingDef>Silver</thingDef><weight>4</weight></li>
      <li><thingDef>Cloth</thingDef><weight>3</weight></li>
      <li><thingDef>MedicineHerbal</thingDef><weight>2</weight></li>
      <li><thingDef>Steel</thingDef><weight>1</weight></li>
      <li><thingDef>Apparel_Parka</thingDef><weight>1</weight></li>
      <li><thingDef>Apparel_BasicShirt</thingDef><weight>1</weight></li>
      <li><thingDef>Apparel_Pants</thingDef><weight>1</weight></li>
    </loot>
    <richLoot>
