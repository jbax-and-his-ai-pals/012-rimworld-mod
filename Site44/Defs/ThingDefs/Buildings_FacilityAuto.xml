<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- Always-active security turret: no power, fuel or research; not buildable. -->
  <ThingDef ParentName="BuildingBase">
    <defName>Site44_SecurityTurret</defName>
    <label>security turret</label>
    <description>A facility sentry gun running on its own internal supply. It has no friends here.</description>
    <thingClass>Building_TurretGun</thingClass>
    <drawerType>MapMeshAndRealTime</drawerType>
    <drawHighlight>true</drawHighlight>
    <drawHighlightOnlyForHostile>true</drawHighlightOnlyForHostile>
    <graphicData>
      <texPath>Things/Building/Security/TurretMini_Base</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(3,3)</drawSize>
      <damageData>
        <rect>(0.2,0.2,0.6,0.6)</rect>
      </damageData>
      <shadowData>
        <volume>(0.27,0.25,0.27)</volume>
        <offset>(0,0,0)</offset>
      </shadowData>
    </graphicData>
    <uiIconPath>Things/Building/Security/TurretMini_MenuIcon</uiIconPath>
    <uiIconScale>0.90</uiIconScale>
    <altitudeLayer>Building</altitudeLayer>
    <stealable>false</stealable>
    <rotatable>false</rotatable>
    <statBases>
      <MaxHitPoints>150</MaxHitPoints>
      <Flammability>0.3</Flammability>
      <Beauty>-20</Beauty>
      <ShootingAccuracyTurret>0.96</ShootingAccuracyTurret>
    </statBases>
    <tickerType>Normal</tickerType>
    <comps>
      <li Class="CompProperties_Forbiddable"/>
      <li Class="CompProperties_Stunnable">
        <affectedDamageDefs>
          <li>Stun</li>
          <li>EMP</li>
        </affectedDamageDefs>
      </li>
    </comps>
    <passability>PassThroughOnly</passability>
    <pathCost>50</pathCost>
    <fillPercent>0.4</fillPercent>
    <hasTooltip>true</hasTooltip>
    <building>
      <combatPower>45</combatPower>
      <ai_combatDangerous>true</ai_combatDangerous>
      <turretGunDef>Gun_MiniTurret</turretGunDef>
      <turretBurstCooldownTime>4.8</turretBurstCooldownTime>
    </building>
    <placeWorkers>
      <li>PlaceWorker_TurretTop</li>
    </placeWorkers>
  </ThingDef>

  <!-- Dim emergency lamp -->
  <ThingDef ParentName="BuildingBase">
    <defName>Site44_LampEmergency</defName>
    <label>emergency lamp</label>
    <description>A sealed emergency lamp that has run on its own cell since the facility was built.</description>
    <thingClass>Building</thingClass>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <selectable>true</selectable>
    <fillPercent>0.20</fillPercent>
    <pathCost>14</pathCost>
    <leaveResourcesWhenKilled>false</leaveResourcesWhenKilled>
    <rotatable>false</rotatable>
    <noRightClickDraftAttack>true</noRightClickDraftAttack>
    <useHitPoints>false</useHitPoints>
    <graphicData>
      <graphicClass>Graphic_Single</graphicClass>
      <texPath>Things/Building/Ruins/AncientLamp</texPath>
    </graphicData>
    <comps>
      <li Class="CompProperties_Glower">
        <glowRadius>5.5</glowRadius>
        <glowColor>(130,75,20,0)</glowColor>
      </li>
    </comps>
    <statBases>
      <MaxHitPoints>50</MaxHitPoints>
    </statBases>
    <building>
      <isInert>true</isInert>
      <deconstructible>false</deconstructible>
    </building>
  </ThingDef>

  <!-- Bright working lamp -->
  <ThingDef ParentName="BuildingBase">
    <defName>Site44_LampBright</defName>
    <label>work lamp</label>
    <description>A sealed, high-output work lamp, bolted in place and running on its own cell.</description>
    <thingClass>Building</thingClass>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <selectable>true</selectable>
    <fillPercent>0.20</fillPercent>
    <pathCost>14</pathCost>
    <leaveResourcesWhenKilled>false</leaveResourcesWhenKilled>
    <rotatable>false</rotatable>
    <noRightClickDraftAttack>true</noRightClickDraftAttack>
    <useHitPoints>false</useHitPoints>
    <graphicData>
      <graphicClass>Graphic_Single</graphicClass>
      <texPath>Things/Building/Ruins/AncientLamp</texPath>
    </graphicData>
    <comps>
      <li Class="CompProperties_Glower">
        <overlightRadius>4.0</overlightRadius>
        <glowRadius>10</glowRadius>
        <glowColor>(300,290,260,0)</glowColor>
      </li>
    </comps>
    <statBases>
      <MaxHitPoints>50</MaxHitPoints>
    </statBases>
    <building>
      <isInert>true</isInert>
      <deconstructible>false</deconstructible>
    </building>
  </ThingDef>

  <!-- Terminal-class consoles (thingClass Site44.Building_FacilityTerminal) -->
  <ThingDef ParentName="BuildingBase">
    <defName>Site44_DiagnosticNode</defName>
    <label>diagnostic node</label>
    <description>A compact data node tapped into the facility diagnostics loop.</description>
    <thingClass>Site44.Building_FacilityTerminal</thingClass>
    <category>Building</category>
    <noRightClickDraftAttack>true</noRightClickDraftAttack>
    <graphicData>
      <texPath>Things/Building/Misc/AncientTerminal/AncientTerminal</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <shadowData>
        <volume>(0.55, 0.30, 0.40)</volume>
      </shadowData>
    </graphicData>
    <size>(1,1)</size>
    <statBases>
      <MaxHitPoints>200</MaxHitPoints>
    </statBases>
    <useHitPoints>false</useHitPoints>
    <fillPercent>0.20</fillPercent>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <pathCost>50</pathCost>
    <rotatable>false</rotatable>
    <selectable>true</selectable>
    <building>
      <isInert>true</isInert>
      <deconstructible>false</deconstructible>
    </building>
  </ThingDef>

  <ThingDef ParentName="BuildingBase">
    <defName>Site44_CoolantValve</defName>
    <label>coolant diversion valve</label>
    <description>A heavy valve junction on the primary coolant loop. Someone has to turn it.</description>
    <thingClass>Site44.Building_FacilityTerminal</thingClass>
    <category>Building</category>
    <noRightClickDraftAttack>true</noRightClickDraftAttack>
    <graphicData>
      <texPath>Things/Building/Ruins/AncientStorageCylinder</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>(2, 1)</drawSize>
      <shadowData>
        <volume>(2, 0.35, 1)</volume>
      </shadowData>
    </graphicData>
    <size>(2,1)</size>
    <statBases>
      <MaxHitPoints>250</MaxHitPoints>
    </statBases>
    <useHitPoints>false</useHitPoints>
    <fillPercent>0.50</fillPercent>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <pathCost>50</pathCost>
    <rotatable>false</rotatable>
    <selectable>true</selectable>
    <building>
      <isInert>true</isInert>
      <deconstructible>false</deconstructible>
    </building>
  </ThingDef>

  <ThingDef ParentName="BuildingBase">
    <defName>Site44_ReactorConsole</defName>
    <label>reactor control console</label>
    <description>The control console for the facility reactor, dark but not dead.</description>
    <thingClass>Site44.Building_FacilityTerminal</thingClass>
    <category>Building</category>
    <noRightClickDraftAttack>true</noRightClickDraftAttack>
    <graphicData>
      <texPath>Things/Building/Ruins/AncientBasicRecharger</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>(2.9,1.25)</drawSize>
      <shadowData>
        <volume>(2.9, 0.5, 0.9)</volume>
      </shadowData>
    </graphicData>
    <size>(3,1)</size>
    <statBases>
      <MaxHitPoints>500</MaxHitPoints>
    </statBases>
    <useHitPoints>false</useHitPoints>
    <fillPercent>0.5</fillPercent>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <pathCost>50</pathCost>
    <rotatable>false</rotatable>
    <selectable>true</selectable>
    <building>
      <isInert>true</isInert>
      <deconstructible>false</deconstructible>
    </building>
  </ThingDef>

</Defs>
