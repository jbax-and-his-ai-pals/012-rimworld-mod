      <li><thingDef>MedicineIndustrial</thingDef><weight>2</weight></li>
      <li><thingDef>Uranium</thingDef><weight>1</weight></li>
    </loot>
    <richLoot>
      <li><thingDef>ComponentSpacer</thingDef><weight>5</weight></li>
      <li><thingDef>Gold</thingDef><weight>3</weight></li>
      <li><thingDef>Plasteel</thingDef><weight>3</weight></li>
      <li><thingDef>Uranium</thingDef><weight>2</weight></li>
      <li><thingDef>MedicineUltratech</thingDef><weight>1</weight></li>
    </richLoot>
    <specialties>
      <li><name>Library</name><weight>2</weight></li>
      <li><name>CommsRoom</name><weight>2</weight></li>
      <li><name>Workshop</name><weight>2</weight></li>
      <li><name>Classroom</name><weight>1</weight></li>
    </specialties>
    <secureRoomFactor>1.8</secureRoomFactor>
    <crateFactor>1.2</crateFactor>
  </Site44.SiteTypeDef>

  <!-- Industrial plant: machine halls, boilers, warehouses. Raw materials; volatile caches. -->
  <Site44.SiteTypeDef>
    <defName>Site44_Type_Industrial</defName>
    <label>industrial plant</label>
    <description>An industrial plant of machine halls, boiler rooms, warehouses and loading bays.</description>
    <sitePart>Site44_Ruin_Industrial</sitePart>
    <questScript>OpportunitySite_Site44_Industrial</questScript>
    <principalArchetype>Plant</principalArchetype>
    <style>Scattered</style>
    <props>industrial</props>
    <accent>(0.95, 0.6, 0.2)</accent>
    <steleStuff>Steel</steleStuff>
    <clutterFactor>2.4</clutterFactor>
    <archetypeWeights>
      <li><name>Plant</name><weight>3</weight></li>
      <li><name>Warehouse</name><weight>3</weight></li>
      <li><name>Office</name><weight>1</weight></li>
      <li><name>Security</name><weight>1</weight></li>
      <li><name>Commons</name><weight>1</weight></li>
    </archetypeWeights>
    <questWeight>0.35</questWeight>
    <loot>
      <li><thingDef>Steel</thingDef><weight>6</weight></li>
      <li><thingDef>ComponentIndustrial</thingDef><weight>4</weight></li>
