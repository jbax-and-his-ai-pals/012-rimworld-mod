<Defs>

  <!-- Higher tiers of temperature protection, and mixed pieces. The best full set reaches the hardest room that can be generated. -->

  <ThingDef ParentName="ApparelBase">
    <defName>Site44_ThermalVest</defName>
    <label>thermal vest</label>
    <description>A padded vest worn under a coat. It keeps the chest warm.</description>
    <techLevel>Industrial</techLevel>
    <graphicData>
      <texPath>Things/Pawn/Humanlike/Apparel/Duster/Duster</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <smeltProducts>
      <Steel>3</Steel>
    </smeltProducts>
    <statBases>
      <MaxHitPoints>80</MaxHitPoints>
      <Mass>1.0</Mass>
      <Flammability>0.3</Flammability>
      <Insulation_Cold>22</Insulation_Cold>
      <EquipDelay>3</EquipDelay>
    </statBases>
    <thingCategories>
      <li>ApparelMisc</li>
    </thingCategories>
    <apparel>
      <bodyPartGroups>
        <li>Torso</li>
      </bodyPartGroups>
      <wornGraphicPath>Things/Pawn/Humanlike/Apparel/Duster/Duster</wornGraphicPath>
      <layers>
        <li>Middle</li>
      </layers>
      <tags />
    </apparel>
    <colorGenerator Class="ColorGenerator_Options">
      <options>
        <li>
          <only>(0.45,0.5,0.55)</only>
        </li>
      </options>
    </colorGenerator>
  </ThingDef>

