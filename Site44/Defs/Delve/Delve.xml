<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <ThingDef ParentName="BuildingBase">
    <defName>Site44_ExtractionGate</defName>
    <label>extraction gate</label>
    <description>A heavy lift-gate at the far end of the complex. It carries whoever stands in it, and whatever is stacked beside it, down to the next level.</description>
    <thingClass>Site44.Building_ExtractionGate</thingClass>
    <category>Building</category>
    <graphicData>
      <texPath>Things/Building/Ruins/AncientCryptosleepPod</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>(3,3)</drawSize>
    </graphicData>
    <size>(2,2)</size>
    <statBases>
      <MaxHitPoints>1000</MaxHitPoints>
    </statBases>
    <useHitPoints>false</useHitPoints>
    <fillPercent>0.5</fillPercent>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <pathCost>50</pathCost>
    <rotatable>false</rotatable>
    <selectable>true</selectable>
    <hasInteractionCell>true</hasInteractionCell>
    <interactionCellOffset>(0,0,-1)</interactionCellOffset>
    <building>
      <isInert>true</isInert>
      <deconstructible>false</deconstructible>
    </building>
  </ThingDef>

  <JobDef>
    <defName>Site44_UseGate</defName>
    <driverClass>Site44.JobDriver_UseGate</driverClass>
    <reportString>using the extraction gate.</reportString>
  </JobDef>

  <ScenPartDef>
    <defName>Site44_Delve</defName>
    <label>delve run</label>
    <category>Fixed</category>
    <scenPartClass>Site44.ScenPart_Site44Delve</scenPartClass>
    <summaryPriority>391</summaryPriority>
    <canBeRandomlyAdded>false</canBeRandomlyAdded>
    <canBePlayerAddedRemoved>false</canBePlayerAddedRemoved>
  </ScenPartDef>

  <ScenarioDef ParentName="ScenarioBase">
    <defName>Site44_DelveRun</defName>
    <label>Site-44 Delve</label>
    <description>A professional crew, one complex after another. Each extraction gate leads to a deeper, harder ruin. Keep the crew alive; the run ends with the last of them.

Playing with Ideology? The Classic ideoligion is chosen for you, because a delving party cannot meet altar, ritual or building demands; you can choose your own under Customize Site-44 settings. Outside-world events (raids, caravan events, visitors, weather) are switched off by default; each group has a switch in the mod settings.</description>
    <scenario Class="Site44.Site44Scenario">
      <summary>Descend through a chain of ruined complexes.</summary>
      <parts>
        <li Class="Site44.ScenPart_Site44StartingPawns">
          <def>ConfigPage_ConfigureStartingPawns</def>
          <pawnCount>3</pawnCount>
          <pawnChoiceCount>8</pawnChoiceCount>
          <requiredSkills>
            <li>Shooting</li>
            <li>Intellectual</li>
          </requiredSkills>
        </li>
        <li Class="ScenPart_PlayerPawnsArriveMethod">
          <def>PlayerPawnsArriveMethod</def>
          <method>Standing</method>
          <visible>false</visible>
        </li>
        <li Class="Site44.ScenPart_Site44Facility">
          <def>Site44_Facility</def>
        </li>
        <li Class="Site44.ScenPart_Site44Delve">
          <def>Site44_Delve</def>
        </li>
      </parts>
    </scenario>
  </ScenarioDef>

  <ScenarioDef ParentName="ScenarioBase">
    <defName>Site44_DelveQuickTest</defName>
    <label>Site-44 Delve (quick test)</label>
    <description>For testing the level chain: tiny complexes, with the extraction gate beside the start and already open. At this size nests and security almost never appear, so it does not test them. Otherwise the same as Site-44 Delve.</description>
    <scenario Class="Site44.Site44Scenario">
      <summary>Test the delve level chain quickly.</summary>
      <parts>
        <li Class="Site44.ScenPart_Site44StartingPawns">
          <def>ConfigPage_ConfigureStartingPawns</def>
          <pawnCount>3</pawnCount>
          <pawnChoiceCount>8</pawnChoiceCount>
          <requiredSkills>
            <li>Shooting</li>
            <li>Intellectual</li>
          </requiredSkills>
        </li>
        <li Class="ScenPart_PlayerPawnsArriveMethod">
          <def>PlayerPawnsArriveMethod</def>
          <method>Standing</method>
          <visible>false</visible>
        </li>
        <li Class="Site44.ScenPart_Site44Facility">
          <def>Site44_Facility</def>
        </li>
        <li Class="Site44.ScenPart_Site44Delve">
          <def>Site44_Delve</def>
          <quickTest>true</quickTest>
        </li>
      </parts>
    </scenario>
  </ScenarioDef>

</Defs>
